# CSP: zwei Inline-Skripte (Importmap, Splash) sind per Hash erlaubt. Werden sie geändert, Hash neu berechnen (sha256, base64).
# Radio: Sender-Adressen gibt der Besucher selbst ein, deshalb media-src https:.
# Cloudflare Web Analytics (Beacon) ist von Cloudflare eingefügt und deshalb erlaubt.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-dXx8nKFDbETEDkeoL5dwLI/K/QJnSxrdf2XqueMyELs=' 'sha256-hiVva3JKiFhnw46OvHSP21e4OFsRBhBsYBq4UI4k7Hg=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob: https:; connect-src 'self' blob: data: https://mempool.space wss://mempool.space https://api.binance.com https://api.coingecko.com https://cloudflareinsights.com; worker-src 'self' blob:; base-uri 'self'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
